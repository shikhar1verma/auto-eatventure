# ===========================================
# Auto-Eatventure Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Platform selection: "android" or "ios"
PLATFORM="ios"

# ===========================================
# Cloud Save Credentials (optional)
# ===========================================
EMAIL=""
PASSWORD=""

# ===========================================
# Android Settings (if using Android)
# ===========================================
# Leave empty to auto-detect first connected device
ANDROID_SERIAL=""
ANDROID_PACKAGE="com.hwqgrhhjfd.idlefastfood"

# ===========================================
# iOS Settings (if using iOS)
# ===========================================
# Device UDID - find with: idevice_id -l
# Or in Finder: Click on your iPhone > Click on device name repeatedly until UDID appears
IOS_UDID=""

# App bundle ID (usually same as Android package)
IOS_BUNDLE_ID="com.hwqgrhhjfd.idlefastfood"

# Your iPhone name (as shown in Finder/iTunes)
IOS_DEVICE_NAME="iPhone"

# iOS version on your device (e.g., "17.0", "16.5")
IOS_PLATFORM_VERSION="17.0"

# Appium server URL (default is localhost)
APPIUM_URL="http://127.0.0.1:4723"

# WebDriverAgent bundle ID
# IMPORTANT: Change this to match what you set in Xcode
# Format: com.YOURNAME.WebDriverAgentRunner
WDA_BUNDLE_ID="com.yourname.WebDriverAgentRunner"