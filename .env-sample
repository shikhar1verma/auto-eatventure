# ===========================================
# Auto-Eatventure Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Platform selection: "android", "ios", or "playcover"
# Use "playcover" for Apple Silicon Macs (M1/M2/M3)
PLATFORM="playcover"

# ===========================================
# Cloud Save Credentials (optional)
# ===========================================
EMAIL=""
PASSWORD=""

# ===========================================
# Android Settings (if using Android)
# ===========================================
# Leave empty to auto-detect first connected device
ANDROID_SERIAL=""
ANDROID_PACKAGE="com.hwqgrhhjfd.idlefastfood"

# ===========================================
# iOS Settings (if using iOS)
# ===========================================
# Use iOS Simulator instead of physical device
# Set to "true" to use Simulator (easier setup, no signing required)
IOS_USE_SIMULATOR="true"

# Device UDID - find with: idevice_id -l (not needed for Simulator)
# Or in Finder: Click on your iPhone > Click on device name repeatedly until UDID appears
IOS_UDID=""

# App bundle ID (usually same as Android package)
IOS_BUNDLE_ID="com.hwqgrhhjfd.idlefastfood"

# Simulator/Device name (e.g., "iPhone 14 Pro" for simulator)
IOS_DEVICE_NAME="iPhone 14 Pro"

# iOS version (e.g., "17.0", "16.5")
IOS_PLATFORM_VERSION="17.0"

# Appium server URL (default is localhost)
APPIUM_URL="http://127.0.0.1:4723"

# WebDriverAgent bundle ID (not needed for Simulator)
# IMPORTANT: For physical device, change this to match what you set in Xcode
# Format: com.YOURNAME.WebDriverAgentRunner
WDA_BUNDLE_ID="com.yourname.WebDriverAgentRunner"

# ===========================================
# PlayCover Settings (for Apple Silicon Macs)
# ===========================================
# PlayCover runs iOS apps natively on M1/M2/M3 Macs
# Install: brew install --cask playcover-community
# Then import your IPA into PlayCover

# App name as it appears in the window title
PLAYCOVER_APP_NAME="Idle Cooking Tycoon"

# Window scale factor (1.0 = iPhone points, adjust if using larger window)
PLAYCOVER_WINDOW_SCALE="1.0"

# ===========================================
# Debug Settings
# ===========================================
# Save screenshots with tap markers to debug_taps/ folder
# Blue circle = where target was detected
# Red circle = where tap actually lands
DEBUG_TAPS="true"